@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthProvider
@inject IAuthService Auth
@inject ApiHttpClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ThemeService Theme
@inject LocalizationService Local
@implements IDisposable

@if (_isAuthenticated && !_isSetupPage)
{
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand">
                <span class="logo">B</span>
                <span>BudgetFriend</span>
            </div>
            <NavMenu />
            <div class="sidebar-footer">
                <div style="display:flex; flex-direction:column; gap:12px;">
                    <ThemeSwitch />
                    <LanguageSwitch />
                    <button class="nav-link" @onclick="LogoutAsync">
                        <span class="nav-icon"><SvgIcon Name="logout" Size="20" /></span>
                        <span>@Local["Settings.Logout"]</span>
                    </button>
                </div>
            </div>
        </aside>

        <div class="app-main">
            <TopBar />
            <main class="app-content">
                @Body
            </main>
        </div>

        <NavMenu IsBottom="true" />
    </div>
}
else
{
    <div class="auth-chrome">
        <TopBar />
        <div class="auth-shell @(_isSetupPage ? "setup-shell" : "")">
            @Body
        </div>
    </div>
}

@code {
    private bool _isAuthenticated;
    private bool _isSetupPage;
    private bool _routing;
    private DotNetObjectReference<MainLayout>? _self;

    // ---- Lifecycle -----------------------------------------------------------

    protected override void OnInitialized()
    {
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        Theme.ThemeChanged += OnChromeChanged;
        Local.LanguageChanged += OnChromeChanged;
        Api.SessionExpired += OnSessionExpired;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!Auth.IsAuthenticated)
            {
                // Restores a persisted session (browser storage / secure storage)
                // and raises the authentication state change event.
                await Auth.InitializeAsync();
            }

            await Theme.InitializeAsync();
            if (Theme.SelectedTheme == AppTheme.System)
            {
                var prefersDark = await JS.InvokeAsync<bool>("bf.prefersDark");
                await Theme.ApplySystemSchemeAsync(prefersDark);
            }
            await Local.InitializeAsync();
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("bf.applyTheme", Theme.IsDark);
            await JS.InvokeVoidAsync("bf.applyLanguage", Local.LanguageCode);
            await JS.InvokeVoidAsync("bf.watchSystemThemeForNet", _self, nameof(OnSystemThemeChanged));
        }
    }

    public void Dispose()
    {
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        Theme.ThemeChanged -= OnChromeChanged;
        Local.LanguageChanged -= OnChromeChanged;
        Api.SessionExpired -= OnSessionExpired;
        Nav.LocationChanged -= OnLocationChanged;
        _self?.Dispose();
    }

    // ---- Interop callbacks ---------------------------------------------------

    [JSInvokable]
    public Task OnSystemThemeChanged(bool isDark) => Theme.ApplySystemSchemeAsync(isDark);

    // ---- Event handlers ------------------------------------------------------

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var state = await task;
        _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
        await InvokeAsync(StateHasChanged);
        _ = HandleRoutingAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = HandleRoutingAsync();

    // Routes the user based on auth state and email-verification status.
    // Route protection is enforced here (instead of endpoint-level [Authorize])
    // because authentication is JWT-in-handler. Onboarding (/onboarding) and
    // email verification (/verify-email) render in the slim setup chrome; every
    // other route gets the full app shell. Unverified users are pulled back to
    // /verify-email regardless of which protected page they hit.
    private async Task HandleRoutingAsync()
    {
        if (_routing)
        {
            return;
        }

        _routing = true;
        try
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).Trim('/').ToLowerInvariant();

            if (_isAuthenticated)
            {
                _isSetupPage = path is "onboarding" or "verify-email";

                var profile = await Auth.GetProfileAsync();
                var isKnownUnverified = profile is not null && !profile.IsEmailVerified;

                if (path is "login" or "register" or "forgot-password")
                {
                    Nav.NavigateTo(profile?.IsEmailVerified == true ? "/" : "/onboarding");
                }
                else if (isKnownUnverified && path is not ("onboarding" or "verify-email"))
                {
                    Nav.NavigateTo("/verify-email");
                }
            }
            else
            {
                _isSetupPage = false;
                var isProtected = path is ""
                    or "accounts" or "transactions" or "transfers" or "categories" or "settings"
                    or "onboarding";

                if (isProtected)
                {
                    Nav.NavigateTo("/login");
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _routing = false;
        }
    }

    private async void OnChromeChanged() => await InvokeAsync(OnChromeChangedCore);

    private Task OnChromeChangedCore()
    {
        StateHasChanged();
        return ApplyChromeAsync();
    }

    private async Task ApplyChromeAsync()
    {
        await JS.InvokeVoidAsync("bf.applyTheme", Theme.IsDark);
        await JS.InvokeVoidAsync("bf.applyLanguage", Local.LanguageCode);
    }

    private async Task OnSessionExpired()
    {
        await Auth.LogoutAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        await InvokeAsync(StateHasChanged);
    }
}