@inherits LocalizedComponentBase
@inject IAuthService Auth

<div class="card auth-card">
    <div class="onboarding-icon" style="margin:0 auto 14px;">
        <SvgIcon Name="check" Size="26" />
    </div>
    <h2 class="page-title" style="text-align:center; margin-bottom:8px;">@Local["Verify.Title"]</h2>
    <p class="form-note" style="text-align:center; margin-bottom:18px;">@Local["Verify.Description", Email]</p>

    @if (_error is not null)
    {
        <div class="validation-message" role="alert">@_error</div>
    }
    @if (_success is not null)
    {
        <div class="form-success" role="status">@_success</div>
    }

    <div class="verify-resend">
        <button class="btn btn-ghost" disabled="@_resendBusy" @onclick="ResendAsync">
            @if (_resendBusy)
            {
                <span class="spinner"></span>
            }
            <SvgIcon Name="refresh" Size="15" /> @Local["Auth.ResendVerification"]
        </button>
    </div>
</div>

@code {
    private bool _resendBusy;
    private string? _error;
    private string? _success;

    [Parameter, EditorRequired]
    public string Email { get; set; } = "";

    private async Task ResendAsync()
    {
        if (_resendBusy) return;
        _resendBusy = true;
        _error = null;
        _success = null;
        try
        {
            await Auth.ResendVerificationAsync(Email);
            _success = Local["Verify.Sent"];
        }
        catch (Exception ex)
        {
            _error = BuildError(ex);
        }
        finally
        {
            _resendBusy = false;
        }
    }

    private string? BuildError(Exception ex)
    {
        var error = ApiErrorMessage.From(ex);
        if (error.FieldErrors.Count > 0)
            return string.Join(", ", error.FieldErrors);
        if (!string.IsNullOrWhiteSpace(error.Detail))
            return error.Detail;
        return error.Title is { } key ? Local[key] : Local["Error.Unexpected"];
    }
}