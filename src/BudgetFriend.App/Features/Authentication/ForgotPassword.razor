@inherits LocalizedComponentBase
@page "/forgot-password"
@inject IAuthService Auth
@inject NavigationManager Nav

<div class="card auth-card">
    <div class="brand-large">
        <span class="logo">B</span>
        <span>BudgetFriend</span>
    </div>
    <h2 class="page-title" style="margin-bottom: 20px;">@Local["Auth.ForgotPassword"]</h2>

    @if (_sent)
    {
        <div class="state" style="padding: 24px 8px;">
            <span>@Local["Common.OperationCompleted"]</span>
            <a class="btn btn-primary" href="/login">@Local["Auth.Login"]</a>
        </div>
    }
    else
    {
        <EditForm Model="Model" OnValidSubmit="SubmitAsync" FormName="forgot-password">
            <DataAnnotationsValidator />
            <div class="field">
                <label for="fp-email">@Local["Auth.Email"]</label>
                <InputText id="fp-email" @bind-Value="Model.Email" class="input" type="email" autocomplete="username" />
                <ValidationMessage For="() => Model.Email" />
            </div>

            @if (_errorMessage is not null)
            {
                <div class="validation-message" role="alert">@_errorMessage</div>
            }

            <button class="btn btn-primary btn-block" disabled="@_busy">
                @if (_busy)
                {
                    <span class="spinner"></span>
                }
                @Local["Auth.ResetPassword"]
            </button>
        </EditForm>

        <div class="form-note" style="text-align:center; margin-top:16px;">
            <a href="/login">@Local["Action.Back"]</a>
        </div>
    }
</div>

@code {
    private ForgotPasswordForm Model { get; } = new();
    private bool _busy;
    private bool _sent;
    private string? _errorMessage;

    private async Task SubmitAsync()
    {
        _busy = true;
        _errorMessage = null;
        try
        {
            await Auth.ForgotPasswordAsync(Model.Email!.Trim());
            _sent = true;
        }
        catch
        {
            _errorMessage = Local["Error.Unexpected"];
        }
        finally
        {
            _busy = false;
        }
    }

    public sealed class ForgotPasswordForm
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email address.")]
        public string? Email { get; set; }
    }
}