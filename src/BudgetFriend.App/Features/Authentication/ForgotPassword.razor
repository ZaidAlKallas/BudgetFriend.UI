@inherits LocalizedComponentBase
@page "/forgot-password"
@inject IAuthService Auth
@inject NavigationManager Nav

<div class="card auth-card">
    <div class="brand-large">
        <span class="logo">B</span>
        <span>BudgetFriend</span>
    </div>
    <h2 class="page-title" style="margin-bottom: 20px;">@Local["Auth.ForgotPassword"]</h2>

    @if (_resetDone)
    {
        <div class="state" style="padding: 24px 8px;">
            <span>@Local["Reset.Done.Message"]</span>
            <a class="btn btn-primary" href="/login">@Local["Auth.Login"]</a>
        </div>
    }
    else if (_step == 0)
    {
        <EditForm Model="EmailStep" OnValidSubmit="SubmitEmailAsync" FormName="forgot-password-email">
            <DataAnnotationsValidator />
            <div class="field">
                <label for="fp-email">@Local["Auth.Email"]</label>
                <InputText id="fp-email" @bind-Value="EmailStep.Email" class="input" type="email" autocomplete="username" />
                <ValidationMessage For="() => EmailStep.Email" />
            </div>

            @if (_errorMessage is not null)
            {
                <div class="validation-message" role="alert">@_errorMessage</div>
            }

            <button class="btn btn-primary btn-block" disabled="@_busy" type="submit">
                @if (_busy)
                {
                    <span class="spinner"></span>
                }
                @Local["Auth.SendResetCode"]
            </button>
        </EditForm>

        <div class="form-note" style="text-align:center; margin-top:16px;">
            <a href="/login">@Local["Action.Back"]</a>
        </div>
    }
    else
    {
        <p class="form-note" style="text-align:center; margin-bottom:18px;">@Local["Reset.Code.Description", _email!]</p>

        @if (_successMessage is not null)
        {
            <div class="form-success" role="status">@_successMessage</div>
        }

        <EditForm Model="ResetStep" OnValidSubmit="SubmitResetAsync" FormName="forgot-password-code">
            <DataAnnotationsValidator />
            <div class="field">
                <label for="rp-code">@Local["Auth.VerificationCode"]</label>
                <InputText id="rp-code" @bind-Value="ResetStep.Code" class="input verify-code-input"
                           inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]*" />
                <ValidationMessage For="() => ResetStep.Code" />
            </div>
            <div class="field">
                <label for="rp-new-password">@Local["Auth.NewPassword"]</label>
                <InputText id="rp-new-password" @bind-Value="ResetStep.NewPassword" class="input" type="password" autocomplete="new-password" />
            </div>
            <div class="field">
                <label for="rp-confirm-password">@Local["Auth.ConfirmNewPassword"]</label>
                <InputText id="rp-confirm-password" @bind-Value="ResetStep.ConfirmPassword" class="input" type="password" autocomplete="new-password" />
            </div>

            @if (_errorMessage is not null)
            {
                <div class="validation-message" role="alert">@_errorMessage</div>
            }

            <button class="btn btn-primary btn-block" disabled="@_busy" type="submit">
                @if (_busy)
                {
                    <span class="spinner"></span>
                }
                @Local["Auth.ResetPassword"]
            </button>
        </EditForm>

        <div class="verify-resend">
            <ResendCooldownButton @ref="_resend" Label="@Local["Auth.ResendCode"]" OnResend="ResendAsync" />
        </div>

        <div class="form-note" style="text-align:center; margin-top:16px;">
            <a href="/forgot-password" @onclick="GoBackToEmail" @onclick:preventDefault="true">@Local["Action.Back"]</a>
        </div>
    }
</div>

@code {
    private static readonly System.Text.RegularExpressions.Regex PasswordPolicyRegex = new(
        @"^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[^a-zA-Z0-9]).{8,128}$");

    private ForgotPasswordForm EmailStep { get; } = new();
    private ResetPasswordStep ResetStep { get; } = new();
    private ResendCooldownButton? _resend;
    private string? _email;
    private int _step;
    private bool _busy;
    private bool _resetDone;
    private string? _errorMessage;
    private string? _successMessage;

    private async Task SubmitEmailAsync()
    {
        if (_busy) return;
        _busy = true;
        _errorMessage = null;
        try
        {
            var email = EmailStep.Email!.Trim();
            await Auth.ForgotPasswordAsync(email);
            _email = email;
            _step = 1;
        }
        catch (Exception ex)
        {
            _errorMessage = BuildError(ApiErrorMessage.From(ex));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitResetAsync()
    {
        var newPassword = ResetStep.NewPassword;
        if (string.IsNullOrEmpty(newPassword) || !PasswordPolicyRegex.IsMatch(newPassword))
        {
            _errorMessage = Local["Validation.PasswordPolicy"];
            return;
        }

        if (newPassword != ResetStep.ConfirmPassword)
        {
            _errorMessage = Local["Validation.PasswordMismatch"];
            return;
        }

        if (_busy) return;
        _busy = true;
        _errorMessage = null;
        _successMessage = null;
        try
        {
            await Auth.ResetPasswordAsync(_email!, ResetStep.Code!.Trim(), newPassword);
            _resetDone = true;
        }
        catch (Exception ex)
        {
            var message = BuildError(ApiErrorMessage.From(ex));
            _errorMessage = message;
            if (VerificationCodeErrors.Classify(message) is VerificationCodeFailure.Expired or VerificationCodeFailure.LockedOut)
            {
                ResetStep.Code = null;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResendAsync()
    {
        if (string.IsNullOrEmpty(_email)) return;
        _errorMessage = null;
        _successMessage = null;
        try
        {
            await Auth.ForgotPasswordAsync(_email);
            _successMessage = Local["Reset.CodeResent"];
            _resend?.StartCooldown();
        }
        catch (Exception ex)
        {
            var apiError = ApiErrorMessage.From(ex);
            _errorMessage = BuildError(apiError);
            if (apiError.StatusCode == 429)
            {
                _resend?.StartCooldown();
            }
        }
    }

    private void GoBackToEmail()
    {
        _step = 0;
        _errorMessage = null;
        _successMessage = null;
    }

    private string BuildError(ApiErrorMessage error)
    {
        if (error.FieldErrors.Count > 0)
            return string.Join(", ", error.FieldErrors);
        if (!string.IsNullOrWhiteSpace(error.Detail))
            return error.Detail;
        return error.Title is { } key ? Local[key] : Local["Error.Unexpected"];
    }

    public sealed class ForgotPasswordForm
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email address.")]
        public string? Email { get; set; }
    }

    public sealed class ResetPasswordStep
    {
        [Required(ErrorMessage = "Code is required.")]
        [RegularExpression(@"^[0-9]{6}$", ErrorMessage = "Enter the 6-digit code.")]
        public string? Code { get; set; }

        public string? NewPassword { get; set; }

        public string? ConfirmPassword { get; set; }
    }
}