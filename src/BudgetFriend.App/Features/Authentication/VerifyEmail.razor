@inherits LocalizedComponentBase
@page "/verify-email"
@inject IAuthService Auth
@inject NavigationManager Nav

<div class="verify-page">
    <div class="brand-large" style="justify-content:center; margin-bottom:10px;">
        <span class="logo">B</span>
        <span>BudgetFriend</span>
    </div>

    @if (_verified)
    {
        <EmailVerifiedWelcome />
    }
    else if (Auth.IsAuthenticated && _profile is null)
    {
        <div class="card auth-card">
            <LoadingIndicator />
        </div>
    }
    else if (Auth.IsAuthenticated && _profile?.IsEmailVerified == true)
    {
        <div class="card auth-card onboarding-done">
            <div class="onboarding-icon" style="margin:0 auto 14px;">
                <SvgIcon Name="check" Size="28" />
            </div>
            <h2 class="page-title" style="text-align:center; margin-bottom:8px;">@Local["Verify.Already.Title"]</h2>
            <p class="form-note" style="text-align:center; margin-bottom:18px;">@Local["Verify.Already.Description"]</p>
            <button class="btn btn-primary btn-block" @onclick="GoToDashboard">
                @Local["Onboarding.Done.GoToDashboard"]
            </button>
        </div>
    }
    else
    {
        <div class="card auth-card">
            <div class="onboarding-icon" style="margin:0 auto 14px;">
                <SvgIcon Name="check" Size="26" />
            </div>
            <h2 class="page-title" style="text-align:center; margin-bottom:8px;">@Local["Verify.Title"]</h2>
            <p class="form-note" style="text-align:center; margin-bottom:18px;">
                @if (Auth.IsAuthenticated)
                {
                    @Local["Verify.Description", _profile!.Email]
                }
                else
                {
                    @Local["Verify.DescriptionAnon"]
                }
            </p>

            @if (_success is not null)
            {
                <div class="form-success" role="status">@_success</div>
            }

            <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="verify-code-form">
                <DataAnnotationsValidator />

                @if (!Auth.IsAuthenticated)
                {
                    <div class="field">
                        <label for="verify-email">@Local["Auth.Email"]</label>
                        <InputText id="verify-email" @bind-Value="_model.Email" class="input" type="email" autocomplete="email" />
                        <ValidationMessage For="() => _model.Email" />
                    </div>
                }

                <div class="field">
                    <label for="verify-code">@Local["Auth.VerificationCode"]</label>
                    <InputText id="verify-code" @bind-Value="_model.Code" class="input verify-code-input"
                               inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]*" />
                    <ValidationMessage For="() => _model.Code" />
                </div>

                @if (_error is not null)
                {
                    <div class="validation-message" role="alert">@_error</div>
                }

                <button class="btn btn-primary btn-block" disabled="@_busy" type="submit">
                    @if (_busy)
                    {
                        <span class="spinner"></span>
                    }
                    @Local["Auth.VerifyEmail"]
                </button>
            </EditForm>

            <div class="verify-resend">
                <ResendCooldownButton @ref="_resend" Label="@Local["Auth.ResendVerification"]" OnResend="ResendAsync" />
            </div>

            @if (!Auth.IsAuthenticated)
            {
                <div class="form-note" style="text-align:center; margin-top:16px;">
                    <a href="/login">@Local["Verify.ContinueToLogin"]</a>
                </div>
            }
        </div>
    }
</div>

@code {
    private readonly VerifyCodeForm _model = new();
    private ResendCooldownButton? _resend;
    private bool _verified;
    private bool _loadingProfile;
    private UserProfile? _profile;
    private string? _error;
    private string? _success;
    private bool _busy;

    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated)
        {
            _ = LoadProfileAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The session may be restored by MainLayout after this page's first
        // render. Once the user turns out to be authenticated (and possibly
        // unverified), load the profile lazily so the form can prefill the email.
        if (Auth.IsAuthenticated && _profile is null && !_loadingProfile)
        {
            await LoadProfileAsync();
        }
    }

    private async Task LoadProfileAsync()
    {
        if (_loadingProfile) return;
        _loadingProfile = true;
        try
        {
            _profile = await Auth.GetProfileAsync();
            if (_profile is not null)
            {
                _model.Email = _profile.Email;
            }
        }
        finally
        {
            _loadingProfile = false;
            StateHasChanged();
        }
    }

    private async Task SubmitAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        _success = null;
        try
        {
            var email = Auth.IsAuthenticated ? _profile!.Email : _model.Email!.Trim();
            await Auth.VerifyEmailAsync(email, _model.Code!.Trim());
            _verified = true;
        }
        catch (Exception ex)
        {
            var message = BuildError(ApiErrorMessage.From(ex));
            _error = message;
            if (VerificationCodeErrors.Classify(message) is VerificationCodeFailure.Expired or VerificationCodeFailure.LockedOut)
            {
                _model.Code = null;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResendAsync()
    {
        var email = Auth.IsAuthenticated ? _profile?.Email : _model.Email?.Trim();
        if (string.IsNullOrEmpty(email))
        {
            _error = Local["Auth.EnterEmailFirst"];
            return;
        }

        _error = null;
        _success = null;
        try
        {
            await Auth.ResendVerificationAsync(email);
            _success = Local["Verify.Sent"];
            _resend?.StartCooldown();
        }
        catch (Exception ex)
        {
            var apiError = ApiErrorMessage.From(ex);
            _error = BuildError(apiError);
            if (apiError.StatusCode == 429)
            {
                _resend?.StartCooldown();
            }
        }
    }

    private void GoToDashboard() => Nav.NavigateTo("/", forceLoad: true);

    private string BuildError(ApiErrorMessage error)
    {
        if (error.FieldErrors.Count > 0)
            return string.Join(", ", error.FieldErrors);
        if (!string.IsNullOrWhiteSpace(error.Detail))
            return error.Detail;
        return error.Title is { } key ? Local[key] : Local["Error.Unexpected"];
    }

    public sealed class VerifyCodeForm
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email address.")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Code is required.")]
        [RegularExpression(@"^[0-9]{6}$", ErrorMessage = "Enter the 6-digit code.")]
        public string? Code { get; set; }
    }
}