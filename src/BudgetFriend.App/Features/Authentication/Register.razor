@inherits LocalizedComponentBase
@page "/register"
@inject IAuthService Auth
@inject NavigationManager Nav

<div class="card auth-card">
    <div class="brand-large">
        <span class="logo">B</span>
        <span>BudgetFriend</span>
    </div>
    <h2 class="page-title" style="margin-bottom: 20px;">@Local["Auth.RegisterTitle"]</h2>

    <EditForm Model="Model" OnValidSubmit="RegisterAsync" FormName="register">
        <DataAnnotationsValidator />
        <div class="field">
            <label for="reg-email">@Local["Auth.Email"]</label>
            <InputText id="reg-email" @bind-Value="Model.Email" class="input" type="email" autocomplete="username" />
            <ValidationMessage For="() => Model.Email" />
        </div>
        <div class="grid grid-2" style="gap:10px;">
            <div class="field">
                <label for="reg-first">@Local["Auth.FirstName"]</label>
                <InputText id="reg-first" @bind-Value="Model.FirstName" class="input" autocomplete="given-name" />
                <ValidationMessage For="() => Model.FirstName" />
            </div>
            <div class="field">
                <label for="reg-last">@Local["Auth.LastName"]</label>
                <InputText id="reg-last" @bind-Value="Model.LastName" class="input" autocomplete="family-name" />
            </div>
        </div>
        <div class="field">
            <label for="reg-password">@Local["Auth.Password"]</label>
            <InputText id="reg-password" @bind-Value="Model.Password" class="input" type="password" autocomplete="new-password" />
            <ValidationMessage For="() => Model.Password" />
        </div>
        <div class="field">
            <label for="reg-confirm">@Local["Auth.ConfirmPassword"]</label>
            <InputText id="reg-confirm" @bind-Value="Model.ConfirmPassword" class="input" type="password" autocomplete="new-password" />
            <ValidationMessage For="() => Model.ConfirmPassword" />
        </div>

        @if (_errorMessage is not null)
        {
            <div class="validation-message" role="alert">@_errorMessage</div>
        }

        <button class="btn btn-primary btn-block" disabled="@_busy">
            @if (_busy)
            {
                <span class="spinner"></span>
            }
            @Local["Auth.Register"]
        </button>
    </EditForm>

    <div class="form-note" style="text-align:center; margin-top:16px;">
        @Local["Auth.HasAccount"]
        <a href="/login">@Local["Auth.Login"]</a>
    </div>
</div>

@code {
    private RegisterForm Model { get; } = new();
    private bool _busy;
    private string? _errorMessage;

    private async Task RegisterAsync()
    {
        if (Model.Password != Model.ConfirmPassword)
        {
            _errorMessage = Local["Validation.PasswordMismatch"];
            return;
        }

        _busy = true;
        _errorMessage = null;
        try
        {
            var result = await Auth.RegisterAsync(
                Model.Email!.Trim(),
                Model.Password!,
                Model.FirstName!.Trim(),
                string.IsNullOrWhiteSpace(Model.LastName) ? null : Model.LastName.Trim());

            if (result.IsSuccess)
            {
                // Registration creates an account but may not auto-authenticate.
                Nav.NavigateTo("/login", forceLoad: true);
            }
            else
            {
                _errorMessage = result.Error;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    public sealed class RegisterForm
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email address.")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "First name is required.")]
        public string? FirstName { get; set; }

        public string? LastName { get; set; }

        [Required(ErrorMessage = "Password is required.")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters.")]
        public string? Password { get; set; }

        [Required(ErrorMessage = "Please confirm your password.")]
        public string? ConfirmPassword { get; set; }
    }
}