@inject NavigationManager Nav

<!DOCTYPE html>
<html lang="en" data-bf-theme="light" data-bf-lang="en">

<head>
    <meta charset="utf-8" />
    <script>
        (function () {
            try {
                var t = localStorage.getItem("preferences.theme");
                var dark;
                if (t === "1") dark = false;
                else if (t === "2") dark = true;
                else dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
                document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
            } catch (e) { }
        })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["_content/BudgetFriend.App/css/app.css"]" />
    <link rel="stylesheet" href="@Assets["BudgetFriend.Web.styles.css"]" />
    <HeadOutlet />
    <link rel="icon" type="image/png" href="favicon.png" />
</head>

<body>
    <Routes @rendermode="RouteRenderMode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/BudgetFriend.App/bf.js"]"></script>
</body>

</html>

@code {
    // Prerendering is a whole-response decision: the endpoint renders the tree
    // statically only when the root render mode says so, which is why this is
    // chosen per request here rather than with @rendermode on the pages.
    //
    // Only the public legal documents are prerendered, so that search engines
    // and link previews receive their text in the initial HTML. Everything else
    // stays client-rendered: those routes all require a session, and a
    // prerendered pass would only emit a shell that the client then throws
    // away after redirecting to /login.
    private static readonly IComponentRenderMode Prerendered =
        new InteractiveServerRenderMode(prerender: true);

    private static readonly IComponentRenderMode ClientOnly =
        new InteractiveServerRenderMode(prerender: false);

    private IComponentRenderMode RouteRenderMode =>
        IsLegalPath() ? Prerendered : ClientOnly;

    private bool IsLegalPath() =>
        Nav.ToBaseRelativePath(Nav.Uri).Trim('/').ToLowerInvariant() is "privacy" or "terms";
}